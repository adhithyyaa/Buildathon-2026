# ---- Server ----
PORT=8787
NODE_ENV=development
PUBLIC_BASE_URL="http://localhost:8787"
WEB_ORIGIN="http://localhost:5173"
CURRENCY="INR"

# ---- Database (PostgreSQL) ----
# Local via docker compose (see docker-compose.yml), OR paste a hosted URL (Neon/Supabase).
DATABASE_URL="postgresql://recoup:recoup@localhost:5432/recoup?schema=public"

# ---- Razorpay (TEST MODE) ----
# Create keys at https://dashboard.razorpay.com/app/keys  (toggle to Test Mode first)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# Webhook signing secret you set when creating the webhook in the dashboard.
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"

# ---- Anthropic (AI decision layer) ----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-xxxxxxxx"
# Default claude-opus-5. Faster/cheaper per-case decisions: claude-sonnet-5 or claude-haiku-4-5.
AI_MODEL="claude-opus-5"

# ---- Recovery policy knobs (safe defaults; overridable) ----
POLICY_MAX_RETRIES=3
POLICY_MAX_DISCOUNT_PCT=10
POLICY_HUMAN_APPROVAL_AMOUNT_PAISE=2500000   # ₹25,000
POLICY_QUIET_HOURS_START=21                  # 21:00 IST
POLICY_QUIET_HOURS_END=8                     # 08:00 IST
