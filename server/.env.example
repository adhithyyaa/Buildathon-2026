# ---- Server ----
PORT=8787
NODE_ENV=development
PUBLIC_BASE_URL="http://localhost:8787"
WEB_ORIGIN="http://localhost:5173"
CURRENCY="INR"

# ---- Database (PostgreSQL) ----
# Default: the bundled embedded Postgres (`npm run db:local`, no Docker). This URL matches it.
# Prefer your own DB? Paste any hosted/Docker Postgres URL here instead.
DATABASE_URL="postgresql://recoup:recoup@localhost:5432/recoup?schema=public"

# ---- Razorpay (TEST MODE) ----
# Create keys at https://dashboard.razorpay.com/app/keys  (toggle to Test Mode first)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# Webhook signing secret you set when creating the webhook in the dashboard.
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"

# ---- LLM narrator (explanations, drafted messages, escalation summaries — NOT the decision) ----
# The decision is made by the ML service; the LLM only writes text and never touches money.
# Leave blank to use built-in templates. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-xxxxxxxx"
# Default claude-opus-5. Faster/cheaper narration: claude-sonnet-5 or claude-haiku-4-5.
AI_MODEL="claude-opus-5"

# ---- OR any OpenAI-compatible provider for the narrator (free options!). If set, this wins over Anthropic. ----
# Groq   (free, no card):  https://console.groq.com/keys
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-120b
# Gemini (free tier):      https://aistudio.google.com/apikey
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_MODEL=gemini-3.6-flash
# Ollama (local, no key):  https://ollama.com  (run `ollama pull llama3.1`)
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=llama3.1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ---- Recovery policy knobs (safe defaults; overridable) ----
POLICY_MAX_RETRIES=3
POLICY_MAX_DISCOUNT_PCT=10
POLICY_HUMAN_APPROVAL_AMOUNT_PAISE=2500000   # ₹25,000
POLICY_QUIET_HOURS_START=21                  # 21:00 IST
POLICY_QUIET_HOURS_END=8                     # 08:00 IST
POLICY_MIN_PURSUIT_PAISE=10000               # ₹100 — below this, recovery isn't economical
